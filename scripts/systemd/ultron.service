[Unit]
Description=Ultron Lab Automation Server (Pense Rede)
After=network.target ollama.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/automa-o-ultron
ExecStart=/opt/automa-o-ultron/venv/bin/python3 /opt/automa-o-ultron/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
