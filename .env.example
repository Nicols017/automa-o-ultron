# ==============================================================================
# IA Local Jarvis - Qwen3.5 9B em llama.cpp (Servidor GPU)
# ==============================================================================
LLM_ENABLED=true
LLM_BASE_URL=http://192.168.57.31:8080/v1
LLM_API_KEY=local-dev
LLM_MODEL=local
LLM_TIMEOUT_SECONDS=1200
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1800

LLAMA_BASE_URL=http://192.168.57.31:8080
LLAMA_CHAT_URL=http://192.168.57.31:8080/v1/chat/completions
LLAMA_MODEL=local
LLAMA_MAX_INPUT_TOKENS=6500
LLAMA_MAX_OUTPUT_TOKENS=1200
LLAMA_TIMEOUT_SECONDS=1200

# ==============================================================================
# Ultron Server (Servidor de Aplicação)
# ==============================================================================
ULTRON_SERVER_IP=192.168.57.43
ULTRON_PORT=7000


# ==============================================================================
# ChatOps / semantic intent (DISABLED BY DEFAULT - review before enabling)
# ==============================================================================
ULTRON_SEMANTIC_ROUTER_ENABLED=0
ULTRON_SEMANTIC_READONLY_ENABLED=0
ULTRON_SEMANTIC_ALLOWED_TRUECONF_USERS=
ULTRON_SEMANTIC_ALLOWED_SUBNET=
ULTRON_CHAT_LIVE_CONTEXT_ENABLED=0
ULTRON_OBSIDIAN_RAG_ENABLED=0
ULTRON_OPERATIONAL_DB=data/operational_context.sqlite3

# ==============================================================================
# API auth (do not commit tokens; provision via deployment secret store)
# No token means the protected API/webhook remains unavailable.
# ==============================================================================
ULTRON_ADMIN_API_TOKEN=
ULTRON_TRUECONF_WEBHOOK_SECRET=

# ==============================================================================
# File backup (Robocopy only; not a disk image). Disabled by default.
# ==============================================================================
ULTRON_FILES_BACKUP_ENABLED=0
ULTRON_FILES_BACKUP_SHARE=
ULTRON_FILES_BACKUP_ALLOWED_SUBNET=
ULTRON_BACKUP_ALLOWED_TRUECONF_USERS=


# TrueConf: exact authenticated identities, including realm when supplied by SDK.
# No allowed users means incoming operations are denied.
ULTRON_TRUECONF_URL=https://trueconf.example.invalid
ULTRON_TRUECONF_BOT_USERNAME=ultron
ULTRON_TRUECONF_BOT_PASSWORD=
ULTRON_TRUECONF_API_TOKEN=
ULTRON_TRUECONF_ALLOWED_USERS=
ULTRON_MASTER_TRUECONF_USERS=
# REST CA bundle optional; WebSocket uses the SDK/system trust store (TLS required).
ULTRON_TRUECONF_CA_BUNDLE=
ULTRON_INBOX_DB=data/trueconf_inbox.sqlite3
# Windows packages remain disabled pending an authorized release.
ULTRON_AGENT_DOWNLOAD_ENABLED=false
ULTRON_AGENT_PACKAGE_DIR=agent/dist

# Unified task metadata (single executing server; persist database and lock directory).
ULTRON_JOB_DB=data/tasks.sqlite3

# Short-lived diagnostic clarification; inherits semantic/readonly access controls.
ULTRON_CLARIFICATION_DB=data/clarifications.sqlite3
# Optional operator-provisioned offline JSON inventory; never learned from chat or scanned.
ULTRON_DEVICE_INVENTORY_FILE=
